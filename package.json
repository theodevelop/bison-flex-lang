{
  "name": "bison-flex-lang",
  "displayName": "Bison/Flex Language Support",
  "description": "Full-featured language support for GNU Bison (.y, .yy) and Flex/RE-flex (.l, .ll) — syntax highlighting with embedded C/C++, real-time diagnostics, intelligent autocompletion, and hover documentation for all directives.",
  "version": "1.5.2",
  "publisher": "theodevelop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theodevelop/bison-flex-lang"
  },
  "homepage": "https://github.com/theodevelop/bison-flex-lang#readme",
  "bugs": {
    "url": "https://github.com/theodevelop/bison-flex-lang/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "bison",
    "flex",
    "yacc",
    "lex",
    "re-flex",
    "parser",
    "lexer",
    "grammar",
    "compiler",
    "syntax"
  ],
  "activationEvents": [
    "onLanguage:bison",
    "onLanguage:flex"
  ],
  "main": "./dist/client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bison",
        "aliases": [
          "Bison",
          "Yacc",
          "bison"
        ],
        "extensions": [
          ".y",
          ".yy",
          ".ypp",
          ".bison"
        ],
        "configuration": "./language-config/bison-language-configuration.json"
      },
      {
        "id": "flex",
        "aliases": [
          "Flex",
          "Lex",
          "RE-flex",
          "flex"
        ],
        "extensions": [
          ".l",
          ".ll",
          ".lex",
          ".flex"
        ],
        "configuration": "./language-config/flex-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bison",
        "scopeName": "source.bison",
        "path": "./syntaxes/bison.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.cpp": "cpp"
        }
      },
      {
        "language": "flex",
        "scopeName": "source.flex",
        "path": "./syntaxes/flex.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.cpp": "cpp"
        }
      }
    ],
    "snippets": [
      {
        "language": "bison",
        "path": "./snippets/bison.json"
      },
      {
        "language": "flex",
        "path": "./snippets/flex.json"
      }
    ],
    "commands": [
      {
        "command": "bisonFlex.compileBison",
        "title": "Bison: Compile",
        "icon": "$(play)"
      },
      {
        "command": "bisonFlex.compileFlex",
        "title": "Flex: Compile",
        "icon": "$(play)"
      },
      {
        "command": "bisonFlex.showParseTable",
        "title": "Bison: Show Parse Table",
        "icon": "$(table)"
      },
      {
        "command": "bisonFlex.showGrammarGraph",
        "title": "Bison: Show Grammar Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bisonFlex.flexTestRule",
        "title": "Flex: Test Rule",
        "icon": "$(beaker)"
      },
      {
        "command": "bisonFlex.explainConflict",
        "title": "Bison: Explain Conflict",
        "icon": "$(lightbulb)"
      },
      {
        "command": "bisonFlex.generateAstSkeleton",
        "title": "Bison: Generate AST Skeleton",
        "icon": "$(file-code)"
      },
      {
        "command": "bisonFlex.initTasksJson",
        "title": "Bison/Flex: Initialize tasks.json",
        "icon": "$(gear)"
      },
      {
        "command": "bisonFlex.addCmakeTarget",
        "title": "Bison/Flex: Add CMake Target",
        "icon": "$(file-add)"
      },
      {
        "command": "bisonFlex.showReferences",
        "title": "Bison/Flex: Show References",
        "icon": "$(references)"
      },
      {
        "command": "bisonFlex.noOp",
        "title": "Bison/Flex: No-Op (internal)"
      },
      {
        "command": "bisonFlex.showInSource",
        "title": "Bison/Flex: Show in Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bisonFlex.showInGenerated",
        "title": "Bison/Flex: Show in Generated File",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bisonFlex.showInSource",
          "when": "bisonFlexIsGeneratedFile",
          "group": "navigation@100"
        },
        {
          "command": "bisonFlex.showInGenerated",
          "when": "editorLangId == bison || editorLangId == flex",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "bisonFlex.compileBison",
          "when": "editorLangId == bison"
        },
        {
          "command": "bisonFlex.compileFlex",
          "when": "editorLangId == flex"
        },
        {
          "command": "bisonFlex.showParseTable",
          "when": "editorLangId == bison"
        },
        {
          "command": "bisonFlex.showGrammarGraph",
          "when": "editorLangId == bison"
        },
        {
          "command": "bisonFlex.flexTestRule",
          "when": "editorLangId == flex"
        },
        {
          "command": "bisonFlex.explainConflict",
          "when": "editorLangId == bison"
        },
        {
          "command": "bisonFlex.generateAstSkeleton",
          "when": "editorLangId == bison"
        },
        {
          "command": "bisonFlex.initTasksJson",
          "when": "editorLangId == bison || editorLangId == flex"
        },
        {
          "command": "bisonFlex.addCmakeTarget",
          "when": "editorLangId == bison || editorLangId == flex"
        },
        {
          "command": "bisonFlex.showReferences",
          "when": "false"
        },
        {
          "command": "bisonFlex.noOp",
          "when": "false"
        },
        {
          "command": "bisonFlex.showInSource",
          "when": "bisonFlexIsGeneratedFile"
        },
        {
          "command": "bisonFlex.showInGenerated",
          "when": "editorLangId == bison || editorLangId == flex"
        }
      ]
    },
    "configuration": {
      "title": "Bison & Flex",
      "properties": {
        "bisonFlex.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time error detection for Bison and Flex files."
        },
        "bisonFlex.maxDiagnostics": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of diagnostics to report per file."
        },
        "bisonFlex.bisonPath": {
          "type": "string",
          "default": "bison",
          "description": "Path to the Bison executable. Defaults to 'bison' (must be in PATH)."
        },
        "bisonFlex.flexPath": {
          "type": "string",
          "default": "flex",
          "description": "Path to the Flex executable. Defaults to 'flex' (must be in PATH)."
        },
        "bisonFlex.showInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inlay hints for $1, $2, $$, etc. displaying the inferred semantic type from %type/%token declarations."
        },
        "bisonFlex.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Code Lens above Bison rules and Flex start conditions (reference count, entry point indicator)."
        },
        "bisonFlex.enableCmakeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a .y/.l file is not referenced by a BISON_TARGET / FLEX_TARGET in a nearby CMakeLists.txt."
        },
        "bisonFlex.minVersionBison": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Minimum Bison version your project supports (e.g. `\"2.3\"`). Automatically suppresses diagnostics for features requiring a newer version:\n- `bison/missing-empty` and `bison/yacc-compat` are suppressed when the target is below **3.0**.\n\nAlso emits a warning when your grammar uses a feature (e.g. `api.value.type=variant`) that requires a version higher than your target."
        },
        "bisonFlex.minVersionFlex": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Minimum Flex version your project supports (e.g. `\"2.5\"`). Reserved for future version-gated Flex checks."
        },
        "bisonFlex.disabledChecks": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Diagnostic codes to silence entirely, regardless of version settings. Example: `[\"bison/shift-reduce\", \"flex/missing-yywrap\"]`.\n\nSee all available codes in the [Diagnostic Codes reference](https://github.com/theodevelop/bison-flex-lang/wiki/Diagnostic-Codes)."
        },
        "bisonFlex.buildDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to the directory where Bison/Flex generated files are placed (e.g. `\"build\"` or `\"${workspaceFolder}/out\"`). Used by **Bison/Flex: Show in Generated File** to locate `.tab.c` / `lex.yy.c`. If empty, the extension tries CMake detection, Makefile detection, and the same directory as the source file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "compile:watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint client/src server/src --ext .ts",
    "test-grammar": "vscode-tmgrammar-test -g syntaxes/bison.tmLanguage.json tests/grammar/bison-*.y && vscode-tmgrammar-test -g syntaxes/flex.tmLanguage.json tests/grammar/flex-*.l"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.7.1",
    "merge-options": "^3.0.4",
    "sharp": "^0.34.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vscode-tmgrammar-test": "^0.1.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
